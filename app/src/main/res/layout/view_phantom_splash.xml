<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070F"
    android:contentDescription="Loading Phantom">

    <dev.oneuiproject.oneui.layout.SplashLayout
        android:id="@+id/one_ui_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animated="false"
        app:image="@drawable/ic_launcher_foreground"
        app:title="PHANTOM" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="Powered by KingsHall"
        android:textColor="#B8FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

</FrameLayout>
